{
  "name": "adspilot",
  "version": "3.0.0",
  "description": "AdsPilot - local-first AI-driven Google Ads automation (Go backend + Next.js frontend)",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n adscenter,aicore \"npm:dev:adscenter\" \"npm:dev:aicore\"",
    "dev:adscenter": "cross-env ADSPILOT_LOCAL=1 go run ./services/adscenter",
    "dev:aicore": "cross-env ADSPILOT_LOCAL=1 PORT=8082 go run ./services/aicore",
    "dev:frontend": "cd apps/frontend && npm run dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "npm run test:frontend",
    "test:frontend": "cd apps/frontend && npm test",
    "test:backend": "cd services && go test ./...",
    "verify:backend": "bash scripts/verify-build.sh",
    "clean": "rm -rf apps/frontend/.next apps/frontend/node_modules",
    "setup": "npm install",
    "prepare": "git config core.hooksPath .githooks",
    "security:scan": "bash scripts/security/scan-secrets.sh scan-tree"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "cross-env": "^7.0.3",
    "playwright": "^1.55.1",
    "turbo": "^2.0.9"
  },
  "overrides": {
    "debug": "4.3.4"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/adsorgcn/AdsPilot.git"
  },
  "keywords": [
    "google-ads",
    "go",
    "nextjs",
    "local-first"
  ],
  "author": "AdsPilot",
  "license": "MIT",
  "packageManager": "npm@10.8.2",
  "dependencies": {
    "@playwright/test": "^1.55.1",
    "@supabase/supabase-js": "^2.58.0",
    "dotenv": "^17.2.3",
    "gray-matter": "^4.0.3",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^3.4.10"
  }
}
