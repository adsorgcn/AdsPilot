  "external_apis": [ "Jev decide 接口（早期接入，形状待锁死）" ],
  "limits": { "max_choices": 255, "timeout_s": 8 },
  "unattended": { "accepted": false, "days": 0, "note": "只给选项与分布；向量由主干本地规则给，模式由 f_v5 算" }
}
