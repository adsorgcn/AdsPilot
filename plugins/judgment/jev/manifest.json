{
  "manifest_version": 1,
  "id": "judgment/jev",
  "kind": "judgment",
  "name": "Jev（TypeSafe AI 决策模型，选项分布 / 11 维评估）",
  "version": "2.1.0",
  "status": "alpha",
  "usage": "使用方法.md",
  "actions": { "judge": "provider.py" },
  "credentials": [
    { "env": "JEV_ENDPOINT", "required": true, "note": "https://api.typesafe.ai/v1/systemone 或早期 /decide 端点" },
    { "env": "JEV_API_KEY", "required": true }
  ],
  "external_apis": [ "TypeSafe AI /v1/systemone 或 /decide（jev-latest）" ],
  "limits": { "max_choices": 255, "timeout_s": 8 },
  "unattended": { "accepted": false, "days": 0, "note": "systemone 返回 11 维概率与选项；decide 只给选项与分布；模式永远由本地 f_v5 算" }
}
