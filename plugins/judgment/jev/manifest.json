{
  "manifest_version": 1,
  "id": "judgment/jev",
  "kind": "judgment",
  "name": "Jev（TypeSafe AI 决策模型，选项分布）",
  "version": "2.0.0",
  "status": "alpha",
  "usage": "使用方法.md",
  "actions": { "judge": "provider.py" },
  "credentials": [
    { "env": "JEV_ENDPOINT", "required": true, "note": "早期接入给的端点" },
    { "env": "JEV_API_KEY", "required": true }
