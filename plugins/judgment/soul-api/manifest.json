{
  "manifest_version": 1,
  "id": "judgment/soul-api",
  "kind": "judgment",
  "name": "iLang 托管 SOUL API（公益期免费）",
  "version": "2.1.0",
  "status": "alpha",
  "usage": "使用方法.md",
  "actions": { "judge": "provider.py" },
  "credentials": [
    { "env": "SOUL_API_ENDPOINT", "required": true },
    { "env": "SOUL_API_KEY", "required": true, "note": "公益期在社区领取" }
  ],
  "external_apis": [ "iLang SOUL API /v1/judge（支持 canonical v1 与 ilang-judge 方言）" ],
  "limits": { "timeout_s": 8 },
  "unattended": { "accepted": false, "days": 0, "note": "发前集中清理凭据、gclid 原文与 IP 列表；失败按 provider_chain 或退回本地规则" }
}
