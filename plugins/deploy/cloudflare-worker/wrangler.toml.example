# 复制为 wrangler.toml 后填自己的值。KV 命名空间与 secret 都在用户自己的 Cloudflare 账号里。
name = "adspilot-go"
main = "worker.js"
compatibility_date = "2026-09-01"

# 自有域名（Google Ads 的 Final URL 域名下），例如 go.example.com
routes = [ { pattern = "go.example.com/*", zone_name = "example.com" } ]

[[kv_namespaces]]
binding = "MAPPINGS"
id = "<wrangler kv namespace create MAPPINGS 输出的 id>"

[vars]
# offer_ref -> 联盟点击链接与 sub-id 参数名（CJ 用 sid）
OFFERS = '{"cj:100001:12345":{"url":"https://www.anrdoezrs.net/click-PID-LINKID?url=https%3A%2F%2Fbrand.example%2Fp","param":"sid"}}'

# secret 用命令放，不写在这里：  wrangler secret put EXPORT_KEY
