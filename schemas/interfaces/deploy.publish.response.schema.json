{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deploy.publish response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "pushed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "offers_total": {
          "type": "integer"
        }
      },
      "required": [
        "host",
        "pushed"
      ],
      "additionalProperties": true
    }
  ]
}
