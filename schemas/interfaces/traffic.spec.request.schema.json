{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traffic.spec request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "brief": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "offer_ref": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "final_url": {
          "type": "string",
          "minLength": 1
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "match": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "text"
            ],
            "additionalProperties": true
          },
          "minItems": 1
        },
        "headlines": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "descriptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "daily_budget": {
          "type": "number"
        },
        "max_cpc": {
          "type": "number"
        },
        "is_new_account": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "keywords",
        "headlines",
        "descriptions"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "brief"
  ],
  "additionalProperties": false
}
