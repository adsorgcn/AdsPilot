{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger.subid response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "tokens": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "tokens"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "token": {
          "type": "string"
        }
      },
      "required": [
        "token"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "mappings": {
          "type": "integer",
          "minimum": 0
        },
        "conversions": {
          "type": "integer",
          "minimum": 0
        },
        "runs": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mappings",
        "conversions",
        "runs"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "new": {
          "type": "integer",
          "minimum": 0
        },
        "duplicate": {
          "type": "integer",
          "minimum": 0
        },
        "invalid": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "new",
        "duplicate",
        "invalid"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "output_file": {
          "type": "string"
        }
      },
      "required": [
        "rows",
        "output_file"
      ],
      "additionalProperties": true
    }
  ]
}
