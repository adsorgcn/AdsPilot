{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh.handoff response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "dry_run": { "const": true }
      },
      "required": ["interface", "action", "dry_run"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": { "enum": ["appended", "already recorded"] }
      },
      "required": ["status"],
      "additionalProperties": false
    }
  ]
}
