{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "affiliate.offers request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "days": {
      "type": "integer",
      "minimum": 1
    },
    "advertiser_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "campaign_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "with_links": {
      "type": "boolean"
    },
    "with_terms": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false,
  "deprecated": true,
  "description": "2.1.0 共用形状。可调用的 CJ 与 Impact 接口使用注册表中各提供者的请求 schema。"
}
