{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deploy.setup request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "host": {
      "type": "string",
      "pattern": "^[A-Za-z0-9.-]+$"
    },
    "teardown": {
      "type": "boolean"
    }
  },
  "required": [],
  "additionalProperties": false
}
