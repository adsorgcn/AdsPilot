{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "affiliate.link request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "pattern": "^https?://"
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9]{8,32}$"
    }
  },
  "required": [
    "base",
    "token"
  ],
  "additionalProperties": false
}
