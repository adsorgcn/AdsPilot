{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dsh.handoff request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "report": {
      "type": "string",
      "minLength": 1
    },
    "memory": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": ["report", "memory"],
  "additionalProperties": false
}
