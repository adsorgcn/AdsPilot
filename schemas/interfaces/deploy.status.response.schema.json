{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deploy.status response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "host": {
          "type": "string",
          "minLength": 1
        },
        "health": {
          "type": "object"
        }
      },
      "required": [
        "host",
        "health"
      ],
      "additionalProperties": true
    }
  ]
}
