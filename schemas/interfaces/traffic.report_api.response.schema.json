{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traffic.report_api response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "type",
        "schema_version",
        "platform",
        "currency",
        "pulled_at",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "adspilot.traffic_report"
        },
        "schema_version": {
          "const": 1
        },
        "platform": {
          "type": "string"
        },
        "account": {
          "description": "账号标识，可打码。",
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "pulled_at": {
          "type": "string"
        },
        "source": {
          "description": "csv_export 或 api。",
          "enum": [
            "csv_export",
            "api"
          ]
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "date",
              "campaign",
              "impressions",
              "clicks",
              "cost"
            ],
            "additionalProperties": false,
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "campaign": {
                "type": "string"
              },
              "campaign_id": {
                "type": "string"
              },
              "campaign_status": {
                "type": "string"
              },
              "adgroup": {
                "type": "string"
              },
              "adgroup_id": {
                "type": "string"
              },
              "keyword": {
                "type": "string"
              },
              "keyword_id": {
                "type": "string"
              },
              "match": {
                "enum": [
                  "phrase",
                  "exact",
                  "broad",
                  ""
                ]
              },
              "impressions": {
                "type": "integer",
                "minimum": 0
              },
              "clicks": {
                "type": "integer",
                "minimum": 0
              },
              "cost": {
                "type": "number",
                "minimum": 0
              },
              "avg_cpc": {
                "type": "number",
                "minimum": 0
              },
              "conversions": {
                "type": "number",
                "minimum": 0
              },
              "conv_value": {
                "type": "number",
                "minimum": 0
              },
              "top_of_page_bid": {
                "description": "谷歌给这个词的首页出价估计（广告账户币种），出价上限的兜底。没有就省略。",
                "type": "number",
                "minimum": 0
              },
              "disapproved": {
                "type": "boolean"
              },
              "policy": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  ]
}
