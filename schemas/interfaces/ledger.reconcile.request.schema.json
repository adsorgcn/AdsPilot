{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ledger.reconcile request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "commissions": {
      "type": "object",
      "required": [
        "type",
        "schema_version",
        "network",
        "currency",
        "pulled_at",
        "rows"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "adspilot.commissions"
        },
        "schema_version": {
          "const": 1
        },
        "network": {
          "type": "string"
        },
        "publisher_id": {
          "type": "string"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "pulled_at": {
          "type": "string"
        },
        "window": {
          "type": "object",
          "properties": {
            "since": {
              "type": "string"
            },
            "until": {
              "type": "string"
            }
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "event_id",
              "event_time",
              "sub_id",
              "status",
              "amount",
              "currency"
            ],
            "additionalProperties": false,
            "properties": {
              "event_id": {
                "type": "string",
                "minLength": 1
              },
              "event_time": {
                "type": "string",
                "minLength": 10
              },
              "click_time": {
                "type": "string"
              },
              "sub_id": {
                "description": "我们的 token；空字符串表示这笔没带 sub-id。",
                "type": "string",
                "maxLength": 64
              },
              "status": {
                "enum": [
                  "new",
                  "locked",
                  "extended",
                  "closed",
                  "corrected",
                  "reversed",
                  "unknown"
                ]
              },
              "amount": {
                "description": "发布者佣金，拒付或纠正为负数。",
                "type": "number"
              },
              "sale_amount": {
                "type": "number"
              },
              "currency": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "advertiser": {
                "type": "string"
              },
              "advertiser_id": {
                "type": "string"
              },
              "offer_ref": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "is_chargeback": {
                "type": "boolean"
              },
              "original_event_id": {
                "description": "拒付或纠正所指向的原始事件。",
                "type": "string"
              }
            }
          }
        }
      }
    },
    "conversion_name": {
      "type": "string",
      "minLength": 1
    },
    "window_days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 90
    }
  },
  "required": [
    "commissions"
  ],
  "additionalProperties": false
}
