{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop.ack request",
  "type": "object",
  "properties": {
    "apply": {
      "type": "boolean"
    },
    "dry_run": {
      "type": "boolean"
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{3,63}$"
    }
  },
  "required": [
    "run_id"
  ],
  "additionalProperties": false
}
