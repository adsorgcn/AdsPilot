{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "deploy.setup response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "mode",
        "plan",
        "steps"
      ],
      "additionalProperties": true
    }
  ]
}
