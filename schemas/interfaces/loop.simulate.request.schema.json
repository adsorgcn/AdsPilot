{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "loop.simulate request",
  "type": "object",
  "properties": {
    "runs_dir": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "const": true
    },
    "apply": {
      "const": false
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 366
    }
  },
  "required": [
    "days",
    "runs_dir"
  ],
  "additionalProperties": false
}
