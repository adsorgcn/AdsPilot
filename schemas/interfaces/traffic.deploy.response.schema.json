{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traffic.deploy response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "dry",
            "apply",
            "validate"
          ]
        },
        "results": {
          "type": "array"
        }
      },
      "required": [
        "mode",
        "results"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "dry"
        },
        "created": {
          "type": "object"
        },
        "applied": {
          "const": false
        },
        "plan": {
          "type": "array"
        }
      },
      "required": [
        "mode",
        "created",
        "applied",
        "plan"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "const": "apply"
        },
        "created": {
          "type": "object"
        },
        "applied": {
          "const": true
        }
      },
      "required": [
        "mode",
        "created",
        "applied"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "campaign": {
          "type": "string",
          "minLength": 1
        },
        "campaign_removed": {
          "type": "boolean"
        }
      },
      "required": [
        "campaign",
        "campaign_removed"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "campaign": {
          "type": "string",
          "minLength": 1
        },
        "plan": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "campaign",
        "plan"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "campaign": {
          "type": "string",
          "minLength": 1
        },
        "from": {},
        "to": {
          "type": "string",
          "minLength": 1
        },
        "applied": {
          "type": "boolean"
        }
      },
      "required": [
        "campaign",
        "from",
        "to",
        "applied"
      ],
      "additionalProperties": true
    }
  ]
}
