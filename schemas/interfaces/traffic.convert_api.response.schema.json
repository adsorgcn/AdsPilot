{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traffic.convert_api response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "interface": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string",
          "minLength": 1
        },
        "dry_run": {
          "const": true
        }
      },
      "required": [
        "interface",
        "action",
        "dry_run"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "removed"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "would_remove": {
          "type": "string"
        }
      },
      "required": [
        "would_remove"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string"
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "retractions": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "mode",
        "rows",
        "retractions"
      ],
      "additionalProperties": true
    }
  ]
}
