{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "traffic.budget response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "string",
          "minLength": 1
        },
        "query": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dry_run",
        "query"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "dry_run": {
          "type": "string",
          "minLength": 1
        },
        "body": {
          "type": "object"
        }
      },
      "required": [
        "dry_run",
        "body"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "adspilot.budget_recommendations"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "pulled_at": {
          "type": "string",
          "minLength": 1
        },
        "campaigns": {
          "type": "object"
        }
      },
      "required": [
        "type",
        "currency",
        "pulled_at",
        "campaigns"
      ],
      "additionalProperties": true
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "const": "adspilot.budget_recommendation"
        },
        "currency": {
          "type": "string",
          "minLength": 1
        },
        "pulled_at": {
          "type": "string",
          "minLength": 1
        },
        "recommended": {
          "type": [
            "number",
            "null"
          ]
        },
        "options": {
          "type": "array"
        },
        "current": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "type",
        "currency",
        "pulled_at",
        "recommended",
        "options",
        "current"
      ],
      "additionalProperties": true
    }
  ]
}
