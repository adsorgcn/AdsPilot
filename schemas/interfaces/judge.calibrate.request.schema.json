{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "judge.calibrate request",
  "type": "object",
  "properties": {
    "runs_dir": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "const": true
    },
    "apply": {
      "const": false
    },
    "config": {
      "type": "string",
      "minLength": 1
    },
    "ledger": {
      "type": "string",
      "minLength": 1
    },
    "soul": {
      "type": "string",
      "minLength": 1
    },
    "use_config_fx": {
      "type": "boolean",
      "description": "Explicitly allow the current selected config as a reference FX rate when a run lacks a usable snapshot."
    }
  },
  "required": [
    "runs_dir"
  ],
  "additionalProperties": false
}
