[Unit]
Description=AdsPilot daily unattended loop
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__ROOT__
EnvironmentFile=-/etc/adspilot.env
# Default unit stays explicitly in read-only preview mode (--dry-run).
# Owner-authorized live writes require changing ExecStart to pass --apply AND setting "apply": true in config/adspilot.json.
ExecStart=/usr/bin/env python3 core/loop/daily.py --dry-run
TimeoutStartSec=1800
Nice=10
