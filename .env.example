# AdsPilot 本地凭证模板。
# 用法:复制本文件为仓库根目录的 .env(已被 .gitignore 忽略,绝不会进仓库),
#       填入真实值,然后 .\scripts\dev-local.ps1 或 ./scripts/dev-local.sh 启动,
#       脚本会自动加载。各项的获取方式见 docs/local-auth.md。
#
# 注意:refresh token 不在这里。它由浏览器授权流程自动写入
# ~/.adspilot/credentials.json,永远不需要手工填写。

# Google Cloud 控制台创建的 Desktop 类型 OAuth 客户端
GOOGLE_ADS_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_ADS_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxx

# Google Ads 生产 MCC(经理账号)API Center 里的开发者令牌
GOOGLE_ADS_DEVELOPER_TOKEN=xxxxxxxx

# 登录用的经理账号 CID(纯数字,不带连字符)。
# 用测试账号开发时,填测试经理账号的 CID。
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# 可选:被操作的测试客户账号 CID
GOOGLE_ADS_TEST_CUSTOMER_ID=1234567890
